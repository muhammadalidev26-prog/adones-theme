{
  "name": "Adones Cream",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,

  "semanticTokenColors": {
    "variable": "#F5EAD9",
    "variable.readonly": "#F5EAD9",
    "property": "#E8D8D6",
    "parameter": "#C9B8D9",
    "function": "#E58FB4",
    "method": "#E58FB4",
    "class": "#A78BDE",
    "interface": "#A78BDE",
    "enum": "#A78BDE",
    "namespace": "#A78BDE",
    "type": "#A78BDE",
    "typeParameter": "#A78BDE",
    "enumMember": "#E58FB4",
    "decorator": "#D98CA6",
    "macro": "#D98CA6",
    "keyword": "#B98EE8",
    "modifier": "#B98EE8",
    "operator": "#B8A0C0",
    "comment": "#8A7690",
    "string": "#E8AE8C",
    "number": "#E0B26B",
    "boolean": "#E0B26B"
  },

  "colors": {
    "foreground": "#F5EAD9",

    "editor.background": "#3B2E43",
    "editor.foreground": "#F5EAD9",

    "editor.lineHighlightBackground": "#453750",
    "editor.lineHighlightBorder": "#00000000",

    "editor.selectionBackground": "#8F6FD670",
    "editor.selectionHighlightBackground": "#8F6FD640",
    "editor.inactiveSelectionBackground": "#8F6FD630",

    "editor.wordHighlightBackground": "#8F6FD635",
    "editor.wordHighlightStrongBackground": "#8F6FD655",

    "editorCursor.foreground": "#EDA0C9",

    "editorLineNumber.foreground": "#8A7690",
    "editorLineNumber.activeForeground": "#E4D3D8",

    "editorIndentGuide.background1": "#3F3348",
    "editorIndentGuide.activeBackground1": "#5E4C6B",

    "editorWhitespace.foreground": "#4F4058",

    "editorBracketMatch.background": "#4A3B57",
    "editorBracketMatch.border": "#A78BDE80",

    "editorBracketHighlight.foreground1": "#E58FB4",
    "editorBracketHighlight.foreground2": "#B98EE8",
    "editorBracketHighlight.foreground3": "#E0B26B",
    "editorBracketHighlight.foreground4": "#A78BDE",
    "editorBracketHighlight.foreground5": "#D98CA6",
    "editorBracketHighlight.foreground6": "#E8AE8C",
    "editorBracketHighlight.unexpectedBracket.foreground": "#E36B7A",

    "editor.findMatchBackground": "#E0B26B35",
    "editor.findMatchHighlightBackground": "#E58FB430",
    "editor.findMatchBorder": "#E0B26B80",

    "editorHoverWidget.background": "#443652",
    "editorHoverWidget.border": "#5A4864",

    "editorSuggestWidget.background": "#443652",
    "editorSuggestWidget.foreground": "#F5EAD9",
    "editorSuggestWidget.highlightForeground": "#E58FB4",
    "editorSuggestWidget.selectedBackground": "#4E3F5C",
    "editorSuggestWidget.border": "#5A4864",

    "editorWidget.background": "#443652",
    "editorWidget.border": "#5A4864",

    "editorInfo.foreground": "#A78BDE",
    "editorWarning.foreground": "#E0B26B",
    "editorError.foreground": "#E36B7A",

    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.findMatchForeground": "#E0B26B80",
    "editorOverviewRuler.infoForeground": "#A78BDE80",
    "editorOverviewRuler.warningForeground": "#E0B26B80",
    "editorOverviewRuler.errorForeground": "#E36B7A80",

    "editorGutter.addedBackground": "#8FBF9A80",
    "editorGutter.modifiedBackground": "#E0B26B80",
    "editorGutter.deletedBackground": "#E36B7A80",

    "editorGroup.border": "#3F3348",
    "editorGroupHeader.tabsBackground": "#2B2130",

    "activityBar.background": "#2B2130",
    "activityBar.foreground": "#F5EAD9",
    "activityBar.inactiveForeground": "#736078",
    "activityBar.activeBorder": "#E58FB4",
    "activityBarBadge.background": "#E58FB4",
    "activityBarBadge.foreground": "#2B2130",

    "sideBar.background": "#2B2130",
    "sideBar.foreground": "#E4D3D8",
    "sideBar.border": "#3F3348",
    "sideBarTitle.foreground": "#F5EAD9",

    "sideBarSectionHeader.background": "#3B2E43",
    "sideBarSectionHeader.foreground": "#E4D3D8",
    "sideBarSectionHeader.border": "#3F3348",

    "list.hoverBackground": "#453750",
    "list.hoverForeground": "#F5EAD9",
    "list.activeSelectionBackground": "#4E3F5C",
    "list.activeSelectionForeground": "#F5EAD9",
    "list.inactiveSelectionBackground": "#453750",
    "list.inactiveSelectionForeground": "#E4D3D8",
    "list.focusBackground": "#4E3F5C",
    "list.highlightForeground": "#E58FB4",

    "tab.activeBackground": "#4A3B57",
    "tab.activeForeground": "#F5EAD9",
    "tab.activeBorder": "#E58FB4",
    "tab.inactiveBackground": "#2B2130",
    "tab.inactiveForeground": "#736078",
    "tab.hoverBackground": "#453750",
    "tab.hoverForeground": "#FBF3E8",
    "tab.border": "#2B2130",

    "titleBar.activeBackground": "#2B2130",
    "titleBar.activeForeground": "#E4D3D8",
    "titleBar.inactiveBackground": "#2B2130",
    "titleBar.inactiveForeground": "#736078",
    "titleBar.border": "#3F3348",

    "statusBar.background": "#2B2130",
    "statusBar.foreground": "#C9B4BC",
    "statusBar.border": "#3F3348",
    "statusBar.debuggingBackground": "#B98EE8",
    "statusBar.debuggingForeground": "#2B2130",

    "panel.background": "#3B2E43",
    "panel.border": "#3F3348",
    "panelTitle.activeForeground": "#F5EAD9",
    "panelTitle.activeBorder": "#E58FB4",
    "panelTitle.inactiveForeground": "#736078",

    "input.background": "#453750",
    "input.foreground": "#F5EAD9",
    "input.border": "#5A4864",
    "input.placeholderForeground": "#736078",

    "dropdown.background": "#453750",
    "dropdown.foreground": "#F5EAD9",
    "dropdown.border": "#5A4864",

    "button.background": "#8F6FD6",
    "button.foreground": "#FBF3E8",
    "button.hoverBackground": "#A382E8",

    "menu.background": "#453750",
    "menu.foreground": "#F5EAD9",
    "menu.selectionBackground": "#4E3F5C",
    "menu.selectionForeground": "#FBF3E8",
    "menu.border": "#5A4864",

    "minimap.background": "#3B2E43",
    "minimapSlider.background": "#8F6FD650",
    "minimapSlider.hoverBackground": "#8F6FD670",
    "minimapSlider.activeBackground": "#E58FB470",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#8F6FD640",
    "scrollbarSlider.hoverBackground": "#8F6FD670",
    "scrollbarSlider.activeBackground": "#E58FB470",

    "textLink.foreground": "#E58FB4",
    "textLink.activeForeground": "#F0AECB",

    "badge.background": "#E58FB4",
    "badge.foreground": "#2B2130",

    "progressBar.background": "#E58FB4",

    "notificationCenterHeader.background": "#453750",
    "notificationCenterHeader.foreground": "#F5EAD9",

    "notifications.background": "#453750",
    "notifications.foreground": "#F5EAD9",

    "notificationsInfoIcon.foreground": "#A78BDE",
    "notificationsWarningIcon.foreground": "#E0B26B",
    "notificationsErrorIcon.foreground": "#E36B7A",

    "gitDecoration.addedResourceForeground": "#8FBF9A",
    "gitDecoration.modifiedResourceForeground": "#E0B26B",
    "gitDecoration.deletedResourceForeground": "#E36B7A",
    "gitDecoration.untrackedResourceForeground": "#E0B26B",
    "gitDecoration.ignoredResourceForeground": "#8A7690",
    "gitDecoration.conflictingResourceForeground": "#D98CA6",

    "debugToolBar.background": "#453750",

    "terminal.background": "#3B2E43",
    "terminal.foreground": "#F5EAD9",
    "terminalCursor.foreground": "#EDA0C9",

    "terminal.ansiBlack": "#443652",
    "terminal.ansiRed": "#E36B7A",
    "terminal.ansiGreen": "#8FBF9A",
    "terminal.ansiYellow": "#E0B26B",
    "terminal.ansiBlue": "#A78BDE",
    "terminal.ansiMagenta": "#B98EE8",
    "terminal.ansiCyan": "#E58FB4",
    "terminal.ansiWhite": "#F5EAD9",

    "terminal.ansiBrightBlack": "#8A7690",
    "terminal.ansiBrightRed": "#EF8F9C",
    "terminal.ansiBrightGreen": "#A8D4B3",
    "terminal.ansiBrightYellow": "#EDC98A",
    "terminal.ansiBrightBlue": "#BFA8EA",
    "terminal.ansiBrightMagenta": "#D3AEF5",
    "terminal.ansiBrightCyan": "#F0AECB",
    "terminal.ansiBrightWhite": "#FBF3E8",

    "tree.indentGuidesStroke": "#3F3348",
    "widget.shadow": "#00000040",
    "focusBorder": "#E58FB470"
  },

  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8A7690", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "storage.type",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "storage.type.enum",
        "storage.type.interface"
      ],
      "settings": { "foreground": "#B98EE8" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": { "foreground": "#B8A0C0" }
    },
    {
      "name": "HTML Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "entity.name.tag.localname.xml",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
      ],
      "settings": { "foreground": "#D98CA6" }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": { "foreground": "#E0B26B" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.double.html",
        "string.quoted.single.html",
        "string.quoted.double.js",
        "string.quoted.single.js"
      ],
      "settings": { "foreground": "#E8AE8C" }
    },
    {
      "name": "String Escapes",
      "scope": ["constant.character.escape", "constant.other.placeholder", "variable.interpolation"],
      "settings": { "foreground": "#E0B26B" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function",
        "meta.function-call",
        "meta.definition.method",
        "entity.name.method"
      ],
      "settings": { "foreground": "#E58FB4" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": { "foreground": "#F5EAD9" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#E8D8D6" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"],
      "settings": { "foreground": "#E0B26B" }
    },
    {
      "name": "Booleans and Constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": { "foreground": "#E0B26B" }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#A78BDE" }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": { "foreground": "#E0B26B" }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "meta.selector.css"
      ],
      "settings": { "foreground": "#A78BDE" }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "constant.numeric.css",
        "keyword.other.unit"
      ],
      "settings": { "foreground": "#E8AE8C" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace",
        "meta.bracket",
        "meta.delimiter"
      ],
      "settings": { "foreground": "#8F7A93" }
    },
    {
      "name": "Markup",
      "scope": ["markup.heading", "markup.bold", "markup.italic"],
      "settings": { "foreground": "#E0B26B" }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "string.other.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": { "foreground": "#E58FB4", "fontStyle": "underline" }
    },
    {
      "name": "Regular Expressions",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#E8AE8C" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#E36B7A" }
    },
    {
      "name": "Decorators",
      "scope": ["punctuation.decorator", "meta.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#D98CA6" }
    }
  ]
}