{
  "name": "Adones Coffee",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,

  "semanticTokenColors": {
    "variable": "#CEC6BB",
    "variable.readonly": "#CEC6BB",
    "property": "#D4A58F",
    "parameter": {
      "foreground": "#C99C86",
      "fontStyle": "italic"
    },
    "function": "#8AB6C4",
    "method": "#8AB6C4",
    "class": "#83B9AC",
    "interface": "#83B9AC",
    "enum": "#83B9AC",
    "namespace": "#B9916F",
    "type": "#83B9AC",
    "typeParameter": "#83B9AC",
    "enumMember": "#CFA16E",
    "decorator": "#B9916F",
    "macro": "#B9916F",
    "keyword": "#CBBB4D",
    "modifier": "#D4C87D",
    "operator": "#9FB38C",
    "comment": "#A39F85",
    "string": "#A6C280",
    "number": "#CFA16E",
    "boolean": "#CFA16E"
  },

  "colors": {
    "foreground": "#E6D5C0",

    "editor.background": "#2B2119",
    "editor.foreground": "#E6D5C0",

    "editor.lineHighlightBackground": "#362A20",
    "editor.lineHighlightBorder": "#00000000",

    "editor.selectionBackground": "#7A5A4466",
    "editor.selectionHighlightBackground": "#6B4F3C40",
    "editor.inactiveSelectionBackground": "#6B4F3C40",

    "editor.wordHighlightBackground": "#6B4F3C40",
    "editor.wordHighlightStrongBackground": "#6B4F3C60",

    "editorCursor.foreground": "#D9A566",

    "editorLineNumber.foreground": "#8F7B65",
    "editorLineNumber.activeForeground": "#EDE0CE",

    "editorIndentGuide.background1": "#3A2C21",
    "editorIndentGuide.activeBackground1": "#4F3D2C",

    "editorWhitespace.foreground": "#4A3A2C",

    "editorBracketMatch.background": "#34281E",
    "editorBracketMatch.border": "#9C736080",

    "editorBracketHighlight.foreground1": "#A6C280",
    "editorBracketHighlight.foreground2": "#8AB6C4",
    "editorBracketHighlight.foreground3": "#CFA16E",
    "editorBracketHighlight.foreground4": "#83B9AC",
    "editorBracketHighlight.foreground5": "#D4A58F",
    "editorBracketHighlight.foreground6": "#CBBB4D",
    "editorBracketHighlight.unexpectedBracket.foreground": "#D2665C",

    "editor.findMatchBackground": "#D9A56635",
    "editor.findMatchHighlightBackground": "#A6C28030",
    "editor.findMatchBorder": "#D9A56680",

    "editorHoverWidget.background": "#362A20",
    "editorHoverWidget.border": "#453626",

    "editorSuggestWidget.background": "#362A20",
    "editorSuggestWidget.foreground": "#E6D5C0",
    "editorSuggestWidget.highlightForeground": "#A6C280",
    "editorSuggestWidget.selectedBackground": "#3D2F23",
    "editorSuggestWidget.border": "#453626",

    "editorWidget.background": "#362A20",
    "editorWidget.border": "#453626",

    "editorInfo.foreground": "#7C9CAA",
    "editorWarning.foreground": "#D9A566",
    "editorError.foreground": "#D2665C",

    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.findMatchForeground": "#A6C28080",
    "editorOverviewRuler.infoForeground": "#7C9CAA80",
    "editorOverviewRuler.warningForeground": "#D9A56680",
    "editorOverviewRuler.errorForeground": "#D2665C80",

    "editorGutter.addedBackground": "#A6C28080",
    "editorGutter.modifiedBackground": "#7C9CAA80",
    "editorGutter.deletedBackground": "#D2665C80",

    "editorGroup.border": "#3A2C21",
    "editorGroupHeader.tabsBackground": "#201810",

    "activityBar.background": "#201810",
    "activityBar.foreground": "#E6D5C0",
    "activityBar.inactiveForeground": "#9A8670",
    "activityBar.activeBorder": "#D9A566",
    "activityBarBadge.background": "#D9A566",
    "activityBarBadge.foreground": "#201810",

    "sideBar.background": "#201810",
    "sideBar.foreground": "#C7B39C",
    "sideBar.border": "#2E2318",
    "sideBarTitle.foreground": "#EDE0CE",

    "sideBarSectionHeader.background": "#251C14",
    "sideBarSectionHeader.foreground": "#C7B39C",
    "sideBarSectionHeader.border": "#2E2318",

    "list.hoverBackground": "#362A20",
    "list.hoverForeground": "#E6D5C0",
    "list.activeSelectionBackground": "#3D2F23",
    "list.activeSelectionForeground": "#EDE0CE",
    "list.inactiveSelectionBackground": "#2E241A",
    "list.inactiveSelectionForeground": "#C7B39C",
    "list.focusBackground": "#3D2F23",
    "list.highlightForeground": "#D9A566",

    "tab.activeBackground": "#2B2119",
    "tab.activeForeground": "#EDE0CE",
    "tab.activeBorder": "#D9A566",
    "tab.inactiveBackground": "#201810",
    "tab.inactiveForeground": "#9A8670",
    "tab.hoverBackground": "#362A20",
    "tab.hoverForeground": "#E6D5C0",
    "tab.border": "#201810",

    "titleBar.activeBackground": "#201810",
    "titleBar.activeForeground": "#C7B39C",
    "titleBar.inactiveBackground": "#201810",
    "titleBar.inactiveForeground": "#9A8670",
    "titleBar.border": "#2E2318",

    "statusBar.background": "#201810",
    "statusBar.foreground": "#C7B39C",
    "statusBar.border": "#2E2318",
    "statusBar.debuggingBackground": "#7C9CAA",
    "statusBar.debuggingForeground": "#201810",

    "panel.background": "#201810",
    "panel.border": "#2E2318",
    "panelTitle.activeForeground": "#EDE0CE",
    "panelTitle.activeBorder": "#D9A566",
    "panelTitle.inactiveForeground": "#9A8670",

    "input.background": "#362A20",
    "input.foreground": "#E6D5C0",
    "input.border": "#453626",
    "input.placeholderForeground": "#9A8670",

    "dropdown.background": "#362A20",
    "dropdown.foreground": "#E6D5C0",
    "dropdown.border": "#453626",

    "button.background": "#6B4A38",
    "button.foreground": "#F2E6D8",
    "button.hoverBackground": "#7F5844",

    "menu.background": "#362A20",
    "menu.foreground": "#E6D5C0",
    "menu.selectionBackground": "#3D2F23",
    "menu.selectionForeground": "#F2E6D8",
    "menu.border": "#453626",

    "minimap.background": "#201810",
    "minimapSlider.background": "#6B4F3C50",
    "minimapSlider.hoverBackground": "#6B4F3C70",
    "minimapSlider.activeBackground": "#D9A56670",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#6B4F3C40",
    "scrollbarSlider.hoverBackground": "#6B4F3C70",
    "scrollbarSlider.activeBackground": "#D9A56670",

    "textLink.foreground": "#DE8A66",
    "textLink.activeForeground": "#E8A37E",

    "badge.background": "#C0674A",
    "badge.foreground": "#241A15",

    "progressBar.background": "#C0674A",

    "notificationCenterHeader.background": "#362A20",
    "notificationCenterHeader.foreground": "#E6D5C0",

    "notifications.background": "#362A20",
    "notifications.foreground": "#E6D5C0",

    "notificationsInfoIcon.foreground": "#7C9CAA",
    "notificationsWarningIcon.foreground": "#D9A566",
    "notificationsErrorIcon.foreground": "#D2665C",

    "gitDecoration.addedResourceForeground": "#A6C280",
    "gitDecoration.modifiedResourceForeground": "#7C9CAA",
    "gitDecoration.deletedResourceForeground": "#D2665C",
    "gitDecoration.untrackedResourceForeground": "#D9A566",
    "gitDecoration.ignoredResourceForeground": "#9A8670",
    "gitDecoration.conflictingResourceForeground": "#A98BB0",

    "debugToolBar.background": "#362A20",

    "terminal.background": "#201810",
    "terminal.foreground": "#E6D5C0",
    "terminalCursor.foreground": "#D9A566",

    "terminal.ansiBlack": "#4A3A2C",
    "terminal.ansiRed": "#CC735E",
    "terminal.ansiGreen": "#A6C280",
    "terminal.ansiYellow": "#D4B060",
    "terminal.ansiBlue": "#86AEC0",
    "terminal.ansiMagenta": "#B895A6",
    "terminal.ansiCyan": "#7FAFA0",
    "terminal.ansiWhite": "#E6D5C0",

    "terminal.ansiBrightBlack": "#9A8670",
    "terminal.ansiBrightRed": "#D98A72",
    "terminal.ansiBrightGreen": "#B5D1A0",
    "terminal.ansiBrightYellow": "#E8C48F",
    "terminal.ansiBrightBlue": "#A9C3CE",
    "terminal.ansiBrightMagenta": "#C7AECB",
    "terminal.ansiBrightCyan": "#A8D0C3",
    "terminal.ansiBrightWhite": "#EDE0D2",

    "tree.indentGuidesStroke": "#3A2C21",
    "widget.shadow": "#00000040",
    "focusBorder": "#D9A56670"
  },

  "tokenColors": [

    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A39F85",
        "fontStyle": "italic"
      }
    },

    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "storage.type",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "storage.type.enum",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#CBBB4D"
      }
    },

    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#9FB38C"
      }
    },

    {
      "name": "HTML Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "entity.name.tag.localname.xml",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
      ],
      "settings": {
        "foreground": "#D08C6A"
      }
    },

    {
      "name": "HTML Attributes",

      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#D8A55A"
      }
    },

    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.double.html",
        "string.quoted.single.html",
        "string.quoted.double.js",
        "string.quoted.single.js"
      ],
      "settings": {
        "foreground": "#A6C280"
      }
    },

    {
      "name": "String Escapes",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "variable.interpolation"
      ],
      "settings": {
        "foreground": "#D9B98A"
      }
    },

    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.definition.method",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#8AB6C4"
      }
    },

    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#CEC6BB"
      }
    },

    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D4A58F"
      }
    },

    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#CFA16E"
      }
    },

    {
      "name": "Booleans and Constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": {
        "foreground": "#CFA16E"
      }
    },

    {
      "name": "Types",
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#83B9AC"
      }
    },

    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#B8AC9C"
      }
    },

    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "meta.selector.css"
      ],
      "settings": {
        "foreground": "#D08C6A"
      }
    },

    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "constant.numeric.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#D9B98A"
      }
    },

    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace",
        "meta.bracket",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#9C8C7E"
      }
    },

    {
      "name": "Markup",
      "scope": [
        "markup.heading",
        "markup.bold",
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D08C6A"
      }
    },

    {
      "name": "Markdown Links",
      "scope": [
        "string.other.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#A6C280",
        "fontStyle": "underline"
      }
    },

    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#C792B8"
      }
    },

    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E06E62"
      }
    },

    {
      "name": "Decorators",
      "scope": [
        "punctuation.decorator",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#B9916F"
      }
    }
  ]
}