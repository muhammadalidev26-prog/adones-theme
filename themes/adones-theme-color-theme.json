{
  "name": "Adones Theme",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#CDD7D2",
    "variable.readonly": "#D7DFDA",
    "variable.constant": "#D9A36F",
    "property": "#B9C9C2",
    "parameter": "#B7C6C0",
    "function": "#7DB6D8",
    "method": "#7DB6D8",
    "class": "#B9A0DD",
    "interface": "#B9A0DD",
    "enum": "#B9A0DD",
    "namespace": "#8FB8C4",
    "type": "#B9A0DD",
    "typeParameter": "#C3A9E2",
    "enumMember": "#D9B36F",
    "decorator": "#76B9A5",
    "macro": "#76B9A5",
    "keyword": "#7DB6D8",
    "modifier": "#7DB6D8",
    "operator": "#A9BAB7",
    "comment": "#71807A",
    "string": "#91CDA0",
    "number": "#D99B69",
    "boolean": "#D9A36F"
  },
  "colors": {
    "foreground": "#D4DDD8",
    "editor.background": "#333C43",
    "editor.foreground": "#D4DDD8",
    "editor.lineHighlightBackground": "#394850",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#63879A55",
    "editor.selectionHighlightBackground": "#63879A35",
    "editor.inactiveSelectionBackground": "#63879A30",
    "editor.wordHighlightBackground": "#63879A35",
    "editor.wordHighlightStrongBackground": "#63879A55",
    "editorCursor.foreground": "#8FCFB0",
    "editorLineNumber.foreground": "#62727A",
    "editorLineNumber.activeForeground": "#B8C5C0",
    "editorIndentGuide.background": "#43525A",
    "editorIndentGuide.activeBackground": "#61737C",
    "editorWhitespace.foreground": "#53636B",
    "editorBracketMatch.background": "#40515A",
    "editorBracketMatch.border": "#79B9A480",
    "editorBracketHighlight.foreground1": "#8FCFB0",
    "editorBracketHighlight.foreground2": "#7DB6D8",
    "editorBracketHighlight.foreground3": "#D9B36F",
    "editorBracketHighlight.foreground4": "#79B9A4",
    "editorBracketHighlight.foreground5": "#B9A0DD",
    "editorBracketHighlight.foreground6": "#D99B69",
    "editorBracketHighlight.unexpectedBracket.foreground": "#D77B82",
    "editor.findMatchBackground": "#D9B36F35",
    "editor.findMatchHighlightBackground": "#8FCFB030",
    "editor.findMatchBorder": "#D9B36F80",
    "editorHoverWidget.background": "#3C4B53",
    "editorHoverWidget.border": "#4A5C65",
    "editorSuggestWidget.background": "#3C4B53",
    "editorSuggestWidget.foreground": "#D4DDD8",
    "editorSuggestWidget.highlightForeground": "#8FCFB0",
    "editorSuggestWidget.selectedBackground": "#485B65",
    "editorSuggestWidget.border": "#4A5C65",
    "editorWidget.background": "#3C4B53",
    "editorWidget.border": "#4A5C65",
    "editorInfo.foreground": "#79B9A4",
    "editorWarning.foreground": "#D9B36F",
    "editorError.foreground": "#D77B82",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.findMatchForeground": "#8FCFB080",
    "editorOverviewRuler.infoForeground": "#79B9A480",
    "editorOverviewRuler.warningForeground": "#D9B36F80",
    "editorOverviewRuler.errorForeground": "#D77B8280",
    "editorGutter.addedBackground": "#8FCFB080",
    "editorGutter.modifiedBackground": "#7DB6D880",
    "editorGutter.deletedBackground": "#D77B8280",
    "editorGroup.border": "#46565E",
    "editorGroupHeader.tabsBackground": "#2D383F",
    "activityBar.background": "#273139",
    "activityBar.foreground": "#D4DDD8",
    "activityBar.inactiveForeground": "#77847F",
    "activityBar.activeBorder": "#7DB6D8",
    "activityBarBadge.background": "#7DB6D8",
    "activityBarBadge.foreground": "#273139",
    "sideBar.background": "#2C363D",
    "sideBar.foreground": "#AAB8B2",
    "sideBar.border": "#37474F",
    "sideBarTitle.foreground": "#D4DDD8",
    "sideBarSectionHeader.background": "#344148",
    "sideBarSectionHeader.foreground": "#B2BEB9",
    "sideBarSectionHeader.border": "#37474F",
    "list.hoverBackground": "#3D4B53",
    "list.hoverForeground": "#D4DDD8",
    "list.activeSelectionBackground": "#475B65",
    "list.activeSelectionForeground": "#DCE4E0",
    "list.inactiveSelectionBackground": "#39474F",
    "list.inactiveSelectionForeground": "#AAB8B2",
    "list.focusBackground": "#475B65",
    "list.highlightForeground": "#8FCFB0",
    "tab.activeBackground": "#394850",
    "tab.activeForeground": "#D4DDD8",
    "tab.activeBorder": "#7DB6D8",
    "tab.inactiveBackground": "#273139",
    "tab.inactiveForeground": "#74817D",
    "tab.hoverBackground": "#3D4B53",
    "tab.hoverForeground": "#C7D1CC",
    "tab.border": "#273139",
    "titleBar.activeBackground": "#2B333A",
    "titleBar.activeForeground": "#AAB8B2",
    "titleBar.inactiveBackground": "#2B333A",
    "titleBar.inactiveForeground": "#697670",
    "titleBar.border": "#37474F",
    "statusBar.background": "#2A333A",
    "statusBar.foreground": "#A0ADA7",
    "statusBar.border": "#37474F",
    "statusBar.debuggingBackground": "#7DB6D8",
    "statusBar.debuggingForeground": "#273139",
    "panel.background": "#2E3940",
    "panel.border": "#37474F",
    "panelTitle.activeForeground": "#D4DDD8",
    "panelTitle.activeBorder": "#7DB6D8",
    "panelTitle.inactiveForeground": "#74817D",
    "input.background": "#3C4B53",
    "input.foreground": "#D4DDD8",
    "input.border": "#4A5C65",
    "input.placeholderForeground": "#74817D",
    "dropdown.background": "#3C4B53",
    "dropdown.foreground": "#D4DDD8",
    "dropdown.border": "#4A5C65",
    "button.background": "#47776D",
    "button.foreground": "#E0E7E3",
    "button.hoverBackground": "#56877C",
    "menu.background": "#3C4B53",
    "menu.foreground": "#D4DDD8",
    "menu.selectionBackground": "#475B65",
    "menu.selectionForeground": "#E0E7E3",
    "menu.border": "#4A5C65",
    "minimap.background": "#2E3940",
    "minimapSlider.background": "#5B737C45",
    "minimapSlider.hoverBackground": "#5B737C70",
    "minimapSlider.activeBackground": "#7DB6D870",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#5B737C40",
    "scrollbarSlider.hoverBackground": "#5B737C70",
    "scrollbarSlider.activeBackground": "#7DB6D870",
    "textLink.foreground": "#7DB6D8",
    "textLink.activeForeground": "#9BC9E3",
    "badge.background": "#7DB6D8",
    "badge.foreground": "#273139",
    "progressBar.background": "#7DB6D8",
    "notificationCenterHeader.background": "#3C4B53",
    "notificationCenterHeader.foreground": "#D4DDD8",
    "notifications.background": "#3C4B53",
    "notifications.foreground": "#D4DDD8",
    "notificationsInfoIcon.foreground": "#79B9A4",
    "notificationsWarningIcon.foreground": "#D9B36F",
    "notificationsErrorIcon.foreground": "#D77B82",
    "gitDecoration.addedResourceForeground": "#8FCFB0",
    "gitDecoration.modifiedResourceForeground": "#7DB6D8",
    "gitDecoration.deletedResourceForeground": "#D77B82",
    "gitDecoration.untrackedResourceForeground": "#D9B36F",
    "gitDecoration.ignoredResourceForeground": "#62727A",
    "gitDecoration.conflictingResourceForeground": "#D99B69",
    "debugToolBar.background": "#3C4B53",
    "terminal.background": "#2E3940",
    "terminal.foreground": "#D4DDD8",
    "terminalCursor.foreground": "#8FCFB0",
    "terminal.ansiBlack": "#29363E",
    "terminal.ansiRed": "#D77B82",
    "terminal.ansiGreen": "#8FCFB0",
    "terminal.ansiYellow": "#D9B36F",
    "terminal.ansiBlue": "#7DB6D8",
    "terminal.ansiMagenta": "#B9A0DD",
    "terminal.ansiCyan": "#79B9A4",
    "terminal.ansiWhite": "#D4DDD8",
    "terminal.ansiBrightBlack": "#62727A",
    "terminal.ansiBrightRed": "#E18F94",
    "terminal.ansiBrightGreen": "#A5D9B5",
    "terminal.ansiBrightYellow": "#E5C98D",
    "terminal.ansiBrightBlue": "#9DCBE4",
    "terminal.ansiBrightMagenta": "#C8B6E5",
    "terminal.ansiBrightCyan": "#91CFC1",
    "terminal.ansiBrightWhite": "#E0E7E3",
    "tree.indentGuidesStroke": "#43525A",
    "widget.shadow": "#00000045",
    "focusBorder": "#7DB6D870"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#71807A"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.expression.import",
        "keyword.operator.ternary",
        "keyword.operator.optional",
        "keyword.operator.expression.instanceof",
        "keyword.operator.expression.in",
        "keyword.operator.expression.of",
        "keyword.operator.expression.typeof",
        "keyword.operator.expression.void",
        "storage.type",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "storage.type.enum",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#7DB6D8"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.relational",
        "keyword.operator.assignment.compound"
      ],
      "settings": {
        "foreground": "#A9BAB7"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.double.js",
        "string.quoted.single.js",
        "string.quoted.double.html",
        "string.quoted.single.html",
        "string.template"
      ],
      "settings": {
        "foreground": "#91CDA0"
      }
    },
    {
      "name": "String Escapes and Interpolation",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "variable.interpolation",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#D9B36F"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.any-method",
        "variable.function",
        "meta.function",
        "meta.function-call",
        "meta.function-call.generic",
        "meta.definition.method",
        "entity.name.method",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#7DB6D8"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "function.parameter"
      ],
      "settings": {
        "foreground": "#B7C6C0"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.readwrite.js",
        "variable.other.readwrite.ts"
      ],
      "settings": {
        "foreground": "#CDD7D2"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#D9A36F"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal"
      ],
      "settings": {
        "foreground": "#D99B69"
      }
    },
    {
      "name": "Types and Classes",
      "scope": [
        "support.type",
        "support.type.python",
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.class",
        "entity.name.type.namespace",
        "entity.name.type.module",
        "storage.type"
      ],
      "settings": {
        "foreground": "#B9A0DD"
      }
    },
    {
      "name": "Namespaces and Modules",
      "scope": [
        "entity.name.namespace",
        "support.module.node",
        "support.type.object.module",
        "token.package"
      ],
      "settings": {
        "foreground": "#8FB8C4"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "punctuation.decorator",
        "meta.decorator",
        "entity.name.function.decorator",
        "meta.function.decorator.python",
        "support.token.decorator.python"
      ],
      "settings": {
        "foreground": "#76B9A5"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "support.variable.object"
      ],
      "settings": {
        "foreground": "#B9C9C2"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.separator.delimiter",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition",
        "meta.brace",
        "meta.bracket",
        "meta.delimiter",
        "punctuation.section.block",
        "punctuation.separator.key-value",
        "punctuation.separator.comma"
      ],
      "settings": {
        "foreground": "#8FA39B"
      }
    },
    {
      "name": "HTML Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "entity.name.tag.localname.xml",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
      ],
      "settings": {
        "foreground": "#79B9A4"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#D9B36F"
      }
    },
    {
      "name": "HTML IDs",
      "scope": [
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.id.html"
      ],
      "settings": {
        "foreground": "#7DB6D8"
      }
    },
    {
      "name": "HTML Classes",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.class.html",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#B9A0DD"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#79B9A4"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "meta.selector.css",
        "meta.selector"
      ],
      "settings": {
        "foreground": "#7DB6D8"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.property-value.scss",
        "support.constant.property-value",
        "meta.property-value.css",
        "constant.numeric.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#D9B36F"
      }
    },
    {
      "name": "CSS Colors",
      "scope": [
        "support.constant.color.w3c-standard-color-name.css",
        "support.constant.color.w3c-standard-color-name.scss"
      ],
      "settings": {
        "foreground": "#D99B69"
      }
    },
    {
      "name": "JSON Property Names",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string"
      ],
      "settings": {
        "foreground": "#7DB6D8"
      }
    },
    {
      "name": "JSON String Values",
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json",
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation"
      ],
      "settings": {
        "foreground": "#91CDA0"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#7DB6D8"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold",
        "todo.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": {
        "foreground": "#D9B36F"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic",
        "todo.emphasis"
      ],
      "settings": {
        "foreground": "#B9A0DD"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw.markdown",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#91CDA0"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "string.other.link",
        "string.other.link.title.markdown",
        "string.other.link.description.markdown",
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown"
      ],
      "settings": {
        "foreground": "#7DB6D8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup Punctuation",
      "scope": [
        "punctuation.definition.list.markdown",
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.string.end.markdown",
        "punctuation.definition.metadata.markdown"
      ],
      "settings": {
        "foreground": "#79B9A4"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#D99B69"
      }
    },
    {
      "name": "Embedded Code",
      "scope": [
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end"
      ],
      "settings": {
        "foreground": "#B9A0DD"
      }
    },
    {
      "name": "Diff Added",
      "scope": [
        "markup.inserted.diff"
      ],
      "settings": {
        "foreground": "#8FCFB0"
      }
    },
    {
      "name": "Diff Changed",
      "scope": [
        "markup.changed.diff"
      ],
      "settings": {
        "foreground": "#D9B36F"
      }
    },
    {
      "name": "Diff Deleted",
      "scope": [
        "markup.deleted.diff"
      ],
      "settings": {
        "foreground": "#D77B82"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.broken",
        "invalid.deprecated",
        "invalid.unimplemented"
      ],
      "settings": {
        "foreground": "#D77B82"
      }
    }
  ]
}
